{
  "name": "@heimijj/frontend",
  "version": "0.2.0",
  "private": true,
  "description": "黑米姐姐前端工作区",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "dev:customer": "npm run dev -w @heimijj/customer-miniapp",
    "dev:store": "npm run dev -w @heimijj/store-miniapp",
    "dev:admin": "npm run dev -w @heimijj/admin-web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
